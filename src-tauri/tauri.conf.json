{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SafePatch Preview",
  "version": "0.3.0-preview",
  "identifier": "io.github.henryfir456.safepatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SafePatch Preview — Read-only Update Health",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "henryfir456",
    "shortDescription": "Read-only update health preview; no CVE analysis or automatic updates.",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installers/preview.nsi",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "version": "0.3.0",
        "template": "installers/preview.wxs",
        "upgradeCode": "903586ee-61da-4e98-bc9e-7e59a3bd63a7",
        "enableElevatedUpdateTask": false,
        "language": "en-US"
      }
    }
  }
}
